pref-title = Split-View Reader
pref-section-basic = Basic Settings
pref-follow-focus =
    .label = Follow mouse focus to switch primary view
pref-follow-focus-desc = When enabled, clicking a non-primary view switches the current primary view to it. If no primary view is set, focus changes do not re-enable sync until you set one manually.
pref-split-tabs-title = Show split tabs as
pref-split-tabs-title-desc = Only split-view tabs use this setting. Regular Zotero reader tabs keep Zotero's own tab-title setting.
pref-split-tabs-title-title-creator-year =
    .label = Title - Creator - Year
pref-split-tabs-title-creator-year-title =
    .label = Creator - Year - Title
pref-split-tabs-title-attachment-title =
    .label = Attachment Title
pref-split-tabs-title-filename =
    .label = Filename
pref-remember-split-ratio =
    .label = Remember split ratio per document
pref-remember-split-ratio-desc = Reopening a split view with the same document(s) restores the pane sizing you last used for that pair. Dragging the divider in any split view updates the remembered size for its documents.
pref-section-appearance = Appearance
pref-scrollbar-color = Primary view scrollbar color (RGB):
pref-scrollbar-color-desc = Highlight color for the primary view scrollbar.
pref-section-about = About
pref-about-desc = Split-View Reader is a Zotero plugin for convenient split-screen reading with synchronized controls.
